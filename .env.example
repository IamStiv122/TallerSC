DB_NAME=taller_sc
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# ── Email Configuration (Brevo / smtp-relay.brevo.com) ──────────────────────
# Render bloquea el puerto 587. Usar puerto 465 con SSL en su lugar.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=        # Tu login de Brevo (generalmente tu correo registrado)
EMAIL_HOST_PASSWORD=    # La SMTP Key generada en Brevo (Configuración > SMTP & API)
DEFAULT_FROM_EMAIL=     # Ej: TallerSC <notificaciones@tudominio.com>
